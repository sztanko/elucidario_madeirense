---
import LenGauge from '../../../../components/ui/LenGauge.astro';
// Place page: name, type, parish/municipality/island or country/continent, precision, summary, map, mentions, events, nearby.
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/pages/Breadcrumbs.astro';
import SectionHead from '../../../../components/ui/SectionHead.astro';
import Label from '../../../../components/ui/Label.astro';
import Icon from '../../../../components/ui/Icon.astro';
import Folio from '../../../../components/ui/Folio.astro';
import EntityLink from '../../../../components/ui/EntityLink.astro';
import Timeline from '../../../../components/article/Timeline.astro';
import EventChip from '../../../../components/entity/EventChip.astro';
import Plate from '../../../../components/art/Plate.astro';
import MapView from '../../../../components/map/MapView.astro';
import { fmtEdtf, fmtInt } from '../../../../components/ui/format';
import { languages, places, geo, articles, eventsById, locParts, munsOf, precKey } from '../../../../lib/data';
import { t } from '../../../../i18n/ui';
import * as u from '../../../../lib/urls';

export function getStaticPaths() {
  return languages().flatMap((lang) => Object.keys(places(lang)).map((slug) => ({ params: { lang, slug } })));
}
const { lang, slug } = Astro.params as { lang: string; slug: string };
const p = places(lang)[slug];
const ge = geo()[slug];
const arts = articles(lang);
const mainArticle = p.main ? arts[p.main] : null;
const evMap = eventsById(lang);
const relatedEvents = (p.ev || []).map((id) => evMap.get(id)).filter(Boolean).slice(0, 20) as ReturnType<typeof evMap.get>[];
const MAX_MENTIONS = 40;
const shownMentions = p.m.slice(0, MAX_MENTIONS);
const hiddenMentions = p.m.length - shownMentions.length;

const nearbyIds = (mainArticle?.near ?? []).slice(0, 10);
const nearby = nearbyIds.map((id) => arts[id]).filter(Boolean);

const isAbroad = !ge || ge.isl === 'none' || !ge.isl;
// a levada / stream / road crossing several municipalities lists them all (no single parish then)
const locBits = isAbroad ? locParts(ge?.ctry, ge?.cont)
  : (ge?.muns?.length ?? 0) > 1 ? locParts(...munsOf(ge), ge?.isl) : locParts(ge?.par, ge?.mun, ge?.isl);
const precNote = isAbroad ? null : precKey(ge);
// GPS coordinates (WGS 84) with a Google Maps link — only when the exact location is known
const dms = (v: number, pos: string, neg: string) => {
  const a = Math.abs(v), d = Math.floor(a), m = Math.floor((a - d) * 60), s = Math.round(((a - d) * 60 - m) * 60);
  const [mm, ss] = s === 60 ? [m + 1, 0] : [m, s];
  return `${d}°${String(mm).padStart(2, '0')}′${String(ss).padStart(2, '0')}″ ${v >= 0 ? pos : neg}`;
};
const gps = ge?.c && ge.prec === 'exact'
  ? { lat: dms(ge.c[1], 'N', 'S'), lon: dms(ge.c[0], 'E', 'W'), dec: `${ge.c[1].toFixed(5)}, ${ge.c[0].toFixed(5)}`,
      href: `https://www.google.com/maps/search/?api=1&query=${ge.c[1].toFixed(6)},${ge.c[0].toFixed(6)}` }
  : null;

const site = Astro.site ? Astro.site.href.replace(/\/$/, '') : '';
const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: p.n,
  ...(p.sum ? { description: p.sum } : {}),
  ...(ge?.c ? { geo: { '@type': 'GeoCoordinates', latitude: ge.c[1], longitude: ge.c[0] } } : {}),
  url: site + u.place(lang, slug),
}];
const title = `${p.n} — Elucidário Madeirense`;
// Position on the plane of articles (motion): the main article, else the first article that mentions the place.
const planeAt = p.main ?? p.m[0]?.a;
---
<Base lang={lang} title={title} description={p.sum ?? p.n} kind="entity" jsonld={jsonld} planeId={planeAt}>
  <Breadcrumbs items={[{ label: t(lang, 'back_home'), href: u.home(lang) }, { label: t(lang, 'places'), href: u.placesPage(lang) }, { label: p.n }]} />

  <Folio lang={lang} lead={t(lang, 'type_place')} items={[ge?.tp, ...locBits].filter(Boolean) as string[]} />

  <header class="em-place-head em-role-place">
    <Plate seed={p.id} category="place" size={88} variant="plate" title={p.n} />
    <div>
      <h1>{p.n}</h1>
      {lang !== 'pt' && ge?.pt && ge.pt !== p.n && <p class="em-orig" lang="pt">{ge.pt}</p>}
      {locBits.length > 0 && <p class="em-locbits">{locBits.join(' · ')}</p>}
      {p.loc && <p class="em-loc">{p.loc}</p>}
      {precNote && <p class="em-prec"><Label role="muted" size="micro">{t(lang, precNote)}</Label></p>}
      {gps && (
        <p class="em-gps">
          <a href={gps.href} target="_blank" rel="noopener" title={`${t(lang, 'open_google_maps')} (${gps.dec})`}>
            <Icon name="place" size={13} class="em-gps__pin" />
            <span class="em-gps__c">{gps.lat}</span><span class="em-gps__sep" aria-hidden="true"></span><span class="em-gps__c">{gps.lon}</span>
            <span class="em-gps__l">{t(lang, 'open_google_maps')}<Icon name="external" size={11} /></span>
          </a>
        </p>
      )}
    </div>
  </header>

  {mainArticle && (
    <a class="em-main-card" href={u.article(lang, mainArticle.id)}>
      <span class="em-main-card__k">{t(lang, 'main_article')}</span>
      <span class="em-main-card__hw">{mainArticle.hw}</span>
      {mainArticle.abs && <span class="em-main-card__abs">{mainArticle.abs}</span>}
      <span class="em-main-card__go" aria-hidden="true">→</span>
    </a>
  )}

  {p.sum && <p class="em-lede">{p.sum}{p.ml && <span class="em-langmark" title="English metadata">EN</span>}</p>}

  {ge?.c && (
    <section aria-label={t(lang, 'open_map')}>
      <MapView lang={lang} mode="place" places={[{ id: slug, label: p.n, role: 'subject' }]} region={ge.isl !== 'none' ? ge.isl : ge.cont ?? undefined} height="320px" />
    </section>
  )}


  {shownMentions.length > 0 && (
    <section aria-labelledby="h-mentions">
      <SectionHead size="m" title={t(lang, 'mentioned_in')} id="h-mentions" role="place" n="1">
        <span slot="aside"><Label role="muted" count={fmtInt(ge?.n ?? p.m.length, lang)} /></span>
      </SectionHead>
      <ul class="em-mentions" role="list">
        {shownMentions.map((mn) => (
          <li>
            <LenGauge id={mn.a} lang={lang} /><EntityLink kind="article" id={mn.a} lang={lang} variant="name" label={mn.hw} />
            {mn.note && <span class="em-note"> — {mn.note}</span>}
          </li>
        ))}
      </ul>
      {hiddenMentions > 0 && <p class="em-more-note">+{fmtInt(hiddenMentions, lang)} {t(lang, 'and_n_more')}</p>}
    </section>
  )}

  {relatedEvents.length > 0 && (
    <section aria-labelledby="h-events">
      <SectionHead size="m" title={t(lang, 'dates_mentioned')} id="h-events" role="date" n="2" />
      <Timeline lang={lang} events={relatedEvents as any} />
    </section>
  )}

  {nearby.length > 0 && (
    <section aria-labelledby="h-nearby">
      <SectionHead size="m" title={t(lang, 'nearby')} id="h-nearby" role="place" n="3" />
      <ul class="em-nearby" role="list">
        {nearby.map((a) => (
          <li><LenGauge id={a.id} lang={lang} /><EntityLink kind="article" id={a.id} lang={lang} variant="name" label={a.hw} /></li>
        ))}
      </ul>
    </section>
  )}
</Base>
<style>
  .em-main-card { display: grid; grid-template-columns: 1fr auto; gap: .2rem 1rem; align-items: center; max-width: var(--measure-wide); margin: 0 auto var(--s-6); padding: var(--s-4) var(--s-5); border-top: 4px solid var(--ink); border-bottom: 1px solid var(--ink); background: var(--paper-light); color: var(--ink); text-decoration: none; box-sizing: border-box; }
  @media (max-width: 56rem) { .em-main-card { margin-inline: var(--gutter); } }
  .em-main-card__k { grid-column: 1; font: 700 var(--fs-micro)/1 var(--font-label); letter-spacing: var(--tracking-label, .22em); text-transform: uppercase; color: var(--place-ink); }
  .em-main-card__hw { grid-column: 1; font: 800 var(--fs-h3)/1.05 var(--font-display); text-transform: uppercase; }
  .em-main-card__abs { grid-column: 1; font-size: var(--fs-small); line-height: 1.4; color: var(--ink-2, var(--ink)); }
  .em-main-card__go { grid-column: 2; grid-row: 1 / span 3; font: 800 2.4rem/1 var(--font-display); color: var(--place); transition: transform var(--dur-2, .2s) var(--ease, ease); }
  .em-main-card:hover .em-main-card__go { transform: translateX(.3rem); }
  .em-main-card:hover .em-main-card__hw { color: var(--place-ink); }
</style>
<style>
  .em-place-head { display: flex; gap: var(--s-5); align-items: flex-start; padding: var(--s-6) var(--gutter) var(--s-4); max-width: var(--measure-wide); margin: 0 auto; }
  .em-place-head svg { color: var(--place); flex: none; }
  .em-place-head h1 { font-size: var(--fs-h1); margin: 0; }
  .em-orig { font-family: var(--font-didone); font-style: italic; opacity: .72; margin: .1rem 0 0; }
  .em-locbits { opacity: .7; margin: .3rem 0 0; }
  .em-loc { margin: .3rem 0 0; }
  .em-prec { margin: .4rem 0 0; }
  .em-gps { margin: .55rem 0 0; font-size: var(--fs-micro); line-height: 1; }
  .em-gps a { display: inline-flex; align-items: center; gap: .45em; color: var(--ink-2); text-decoration: none; }
  :global(.em-gps__pin) { color: var(--place); flex: none; }
  .em-gps__c { font-family: var(--font-label); letter-spacing: .08em; font-variant-numeric: tabular-nums; }
  .em-gps__sep { width: 1px; height: .95em; background: currentColor; opacity: .35; }
  .em-gps__l { display: inline-flex; align-items: center; gap: .25em; margin-left: .35em; padding-left: .7em;
    border-left: 1px solid var(--line-faint); font-family: var(--font-label); text-transform: uppercase;
    letter-spacing: var(--tracking-label, .18em); font-size: .92em; color: var(--place-ink, var(--ink)); }
  .em-gps a:hover .em-gps__l { text-decoration: underline; text-underline-offset: .2em; }
  .em-gps a:hover .em-gps__c { color: var(--ink); }
  .em-lede { font-size: var(--fs-lede); max-width: var(--measure); margin: 0 auto var(--s-5); padding: 0 var(--gutter); }
  section { max-width: var(--measure-wide); margin: var(--s-6) auto; padding: 0 var(--gutter); }
  .em-main-article { max-width: var(--measure-wide); margin: 0 auto var(--s-6); padding: 0 var(--gutter); }
  .em-mentions, .em-nearby { list-style: none; margin: var(--s-3) 0 0; padding: 0; }
  .em-mentions li, .em-nearby li { padding: .3rem 0; border-bottom: 1px solid var(--line-faint); font-size: var(--fs-small); }
  .em-note { opacity: .7; }
  .em-more-note { font-size: var(--fs-small); opacity: .6; margin-top: .4rem; }
  .em-event-list { list-style: none; margin: var(--s-3) 0 0; padding: 0; }
</style>
