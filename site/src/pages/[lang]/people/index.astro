---
// People index: A-Z by display name with dates/role, most-mentioned highlights, light client-side role/century filter.
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/pages/Breadcrumbs.astro';
import SectionHead from '../../../components/ui/SectionHead.astro';
import EntityLink from '../../../components/ui/EntityLink.astro';
import { fmtInt } from '../../../components/ui/format';
import { languages, index } from '../../../lib/data';
import { groupBy, centuryOf, toRoman } from '../../../components/pages/content';
import { t } from '../../../i18n/ui';
import * as u from '../../../lib/urls';

export function getStaticPaths() {
  return languages().map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: string };
const idx = index(lang);
// idx.persons: [slug, name, birth, death, mentions, first role]
const highlights = [...idx.persons].sort((a, b) => b[4] - a[4]).slice(0, 12);

const sorted = [...idx.persons].sort((a, b) => a[1].localeCompare(b[1], lang, { sensitivity: 'base' }));
const byLetter = groupBy(sorted, (r) => u.personLetter(r[1]));
const letters = [...byLetter.keys()].sort((a, b) => (a === '0' ? 1 : b === '0' ? -1 : a.localeCompare(b, lang)));
const show = (l: string) => (l === '0' ? '#' : l.toUpperCase());

const roleCounts = new Map<string, number>();
for (const r of idx.persons) {
  const role = (r[5] || '').trim();
  if (role) roleCounts.set(role, (roleCounts.get(role) ?? 0) + 1);
}
const topRoles = [...roleCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 24).map(([role]) => role);

function birthYear(b: string | number | null): number | null {
  if (!b) return null;
  const m = String(b).match(/-?\d{3,4}/);
  return m ? parseInt(m[0], 10) : null;
}
const centuriesPresent = [...new Set(idx.persons.map((r) => { const y = birthYear(r[2]); return y ? centuryOf(y) : null; }).filter((c): c is number => c !== null))].sort((a, b) => a - b);
---
<Base lang={lang} title={`${t(lang, 'people')} — Elucidário Madeirense`} description={t(lang, 'people')} kind="index">
  <Breadcrumbs items={[{ label: t(lang, 'back_home'), href: u.home(lang) }, { label: t(lang, 'people') }]} />
  <SectionHead size="xl" title={t(lang, 'people')} role="person" rule="below" />

  <section class="em-people-root">
    <SectionHead size="m" title={t(lang, 'most_mentioned')} role="person" n="1" />
    <ul class="em-highlight-grid" role="list">
      {highlights.map(([slug, name, birth, death, mentions, role]) => (
        <li>
          <EntityLink kind="person" id={slug} lang={lang} variant="name">{name}</EntityLink>
          <span class="em-sub">{role} · {fmtInt(mentions, lang)}</span>
        </li>
      ))}
    </ul>

    <SectionHead size="m" title={t(lang, 'all_people')} role="person" n="2" />
    <form class="em-filters" id="people-filters">
      <label>{t(lang, 'filter_by_role')}
        <select id="f-role">
          <option value="">{t(lang, 'all')}</option>
          {topRoles.map((r) => <option value={r}>{r}</option>)}
        </select>
      </label>
      <label>{t(lang, 'century_label')}
        <select id="f-century">
          <option value="">—</option>
          {centuriesPresent.map((c) => <option value={c}>{toRoman(c)}</option>)}
        </select>
      </label>
    </form>

    <nav class="em-letter-nav" aria-label={t(lang, 'jump_to_letter')}>
      {letters.map((l) => <a href={u.peopleLetter(lang, l)}>{show(l)}</a>)}
    </nav>

    <div class="em-people-list">
      {letters.map((l) => (
        <section id={`p-${l}`} class="em-letter-group">
          <h3 class="em-letter-h"><a href={u.peopleLetter(lang, l)}>{show(l)} →</a></h3>
          <ul role="list">
            {byLetter.get(l)!.map(([slug, name, birth, death, mentions, role]) => {
              const by = birthYear(birth);
              return (
                <li data-role={role || ''} data-century={by ? centuryOf(by) : ''}>
                  <EntityLink kind="person" id={slug} lang={lang} variant="name">{name}</EntityLink>
                  {(birth || death) && <span class="em-dates">({birth ?? '?'}–{death ?? ''})</span>}
                  {role && <span class="em-role">{role}</span>}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </section>
</Base>
<script>
  const roleSel = document.getElementById('f-role') as HTMLSelectElement | null;
  const centurySel = document.getElementById('f-century') as HTMLSelectElement | null;
  const items = Array.from(document.querySelectorAll('.em-people-list li[data-role]')) as HTMLElement[];
  function apply() {
    const role = roleSel?.value || '';
    const century = centurySel?.value || '';
    for (const li of items) {
      const matchRole = !role || li.dataset.role === role;
      const matchCentury = !century || li.dataset.century === century;
      li.hidden = !(matchRole && matchCentury);
    }
  }
  roleSel?.addEventListener('change', apply);
  centurySel?.addEventListener('change', apply);
</script>
<style>
  .em-people-root { padding: var(--s-5) var(--gutter) var(--s-9); max-width: var(--page-max); margin: 0 auto; }
  .em-highlight-grid { list-style: none; margin: var(--s-4) 0 var(--s-7); padding: 0; columns: 3 14rem; column-gap: var(--col-gap); }
  .em-highlight-grid li { break-inside: avoid; padding: .3rem 0; }
  .em-sub { display: block; font-size: var(--fs-small); opacity: .6; }
  .em-filters { display: flex; gap: var(--s-5); margin: var(--s-4) 0; font-size: var(--fs-small); }
  .em-filters label { display: flex; flex-direction: column; gap: .2em; font-family: var(--font-label); letter-spacing: var(--tracking-label); text-transform: uppercase; font-size: var(--fs-micro); }
  .em-filters select { font: inherit; text-transform: none; letter-spacing: 0; padding: .3em .5em; border: 1px solid var(--line-strong); background: var(--paper-light); }
  .em-letter-nav { display: flex; flex-wrap: wrap; gap: .3rem; margin: 0 0 var(--s-5); position: sticky; top: var(--header-h); background: var(--paper); padding: .5rem 0; z-index: var(--z-raised); }
  .em-letter-nav a { color: var(--ink); text-decoration: none; width: 1.6em; text-align: center; font-size: .85rem; border-bottom: 1px solid var(--person); }
  .em-letter-group { break-inside: avoid; margin-bottom: var(--s-5); }
  .em-letter-h { font-family: var(--font-display); color: var(--person-ink); font-size: var(--fs-h3); font-weight: var(--w-display-x); margin: 0 0 .3rem; border-bottom: 2px solid var(--ink); }
  .em-letter-h a { color: inherit; text-decoration: none; }
  .em-people-list ul { list-style: none; margin: 0; padding: 0; columns: 3 15rem; column-gap: var(--col-gap); }
  .em-people-list li { break-inside: avoid; font-size: var(--fs-small); line-height: 1.6; display: flex; flex-wrap: wrap; gap: .4em; align-items: baseline; }
  .em-dates { opacity: .6; font-variant-numeric: tabular-nums; font-size: .9em; }
  .em-role { opacity: .5; font-size: .78em; text-transform: uppercase; letter-spacing: .03em; }
</style>
