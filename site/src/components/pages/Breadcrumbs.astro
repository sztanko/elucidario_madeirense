---
// Breadcrumb trail + BreadcrumbList JSON-LD. Pages agent owns this component.
// Props: items: { label: string; href?: string }[] (last item has no href)
interface Crumb { label: string; href?: string }
const { items } = Astro.props as { items: Crumb[] };
const site = Astro.site ? Astro.site.href.replace(/\/$/, '') : '';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.label,
    ...(it.href ? { item: site + it.href } : {}),
  })),
};
---
<nav class="em-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => (
      <li aria-current={i === items.length - 1 ? 'page' : undefined}>
        {it.href ? <a href={it.href}>{it.label}</a> : <span>{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
<style>
  .em-breadcrumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: .35em; margin: 0 0 1rem; padding: 0; font-size: .8rem; letter-spacing: .02em; color: color-mix(in srgb, var(--ink) 65%, transparent); }
  .em-breadcrumbs li:not(:last-child)::after { content: '/'; margin-left: .5em; opacity: .5; }
  .em-breadcrumbs a { color: inherit; text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--ink) 30%, transparent); }
  .em-breadcrumbs a:hover { border-color: var(--person); color: var(--person); }
  .em-breadcrumbs [aria-current='page'] { opacity: .85; }
</style>
