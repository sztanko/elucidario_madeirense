---
/**
 * Icon: tiny line-icon set drawn on a 24-unit grid, 1.5 stroke, square caps (woodcut-ish, no rounding).
 * Props:
 *   name: 'search'|'history'|'print'|'menu'|'close'|'arrow-left'|'arrow-right'|'arrow-up'|'arrow-down'|'chevron-down'
 *         |'place'|'person'|'date'|'article'|'map'|'columns'|'rows'|'globe'|'external'|'trash'|'see'
 *   size?: number (px, default 20)
 *   title?: string — if given the icon is announced (role="img"), otherwise aria-hidden.
 *   class?: string
 * Colour: currentColor. Role icons (place/person/date/article) are filled glyphs meant to sit next to text.
 */
interface Props { name: string; size?: number; title?: string; class?: string }
const { name, size = 20, title, class: cls } = Astro.props;
const P: Record<string, string> = {
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/>',
  history: '<path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1"/><path d="M3 4v4.5h4.5"/><path d="M12 7.5V12l3 2"/>',
  print: '<path d="M6.5 9V3.5h11V9"/><rect x="3.5" y="9" width="17" height="8"/><path d="M6.5 14h11v6.5h-11z"/>',
  menu: '<path d="M3 6.5h18M3 12h18M3 17.5h12"/>',
  close: '<path d="m5 5 14 14M19 5 5 19"/>',
  'arrow-left': '<path d="M20 12H4m6-6-6 6 6 6"/>',
  'arrow-right': '<path d="M4 12h16m-6-6 6 6-6 6"/>',
  'arrow-up': '<path d="M12 20V4m-6 6 6-6 6 6"/>',
  'arrow-down': '<path d="M12 4v16m-6-6 6 6 6-6"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  place: '<path d="M12 2.5 19 9.5 12 21.5 5 9.5Z" fill="currentColor" stroke="none"/><circle cx="12" cy="9.5" r="2.3" fill="var(--paper-light)" stroke="none"/>',
  person: '<circle cx="12" cy="7.5" r="4" fill="currentColor" stroke="none"/><path d="M4 21.5c0-4.6 3.6-8 8-8s8 3.4 8 8Z" fill="currentColor" stroke="none"/>',
  date: '<rect x="3.5" y="5" width="17" height="15.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/><rect x="7" y="13" width="3.5" height="3.5" fill="currentColor" stroke="none"/>',
  article: '<path d="M5 2.5h10l4 4v15H5Z" fill="currentColor" stroke="none"/><path d="M8.5 11h7M8.5 14.5h7M8.5 18h4.5" stroke="var(--paper-light)"/>',
  map: '<path d="M3 6 9 3.5l6 2.5 6-2.5V18l-6 2.5L9 18l-6 2.5Z"/><path d="M9 3.5V18m6-12v14.5"/>',
  columns: '<rect x="3" y="4" width="18" height="16"/><path d="M9 4v16m6-16v16"/>',
  rows: '<rect x="5" y="3" width="14" height="18"/><path d="M8 7.5h8M8 11h8M8 14.5h8M8 18h5"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v6H4V6h6"/>',
  trash: '<path d="M4 6.5h16M9 6.5V4h6v2.5M6.5 6.5 7.5 20h9l1-13.5"/>',
  see: '<path d="M3 12h13m-5-5 5 5-5 5"/><path d="M20 4v16"/>',
};
const body = P[name] ?? P.article;
---
<svg
  class:list={['em-icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
><Fragment set:html={body} /></svg>
<style>
  .em-icon { flex: none; display: inline-block; vertical-align: middle; }
</style>
