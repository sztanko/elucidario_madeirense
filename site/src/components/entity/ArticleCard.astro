---
// Featured/listing card for an article. Pages agent owns this component.
// Props: lang, id, hw, hw_pt?, abs?, type? (primary taxonomy code), no? (folio number), ml?: string
import * as u from '../../lib/urls';
import { taxClass } from '../../lib/data';
import Plate from '../art/Plate.astro';
import LenGauge from '../ui/LenGauge.astro';
interface Props { lang: string; id: string; hw: string; hw_pt?: string; abs?: string | null; type?: string; no?: number; ml?: string }
const { lang, id, hw, hw_pt, abs, type, no, ml } = Astro.props as Props;
const role = taxClass(type);
---
<article class="em-card" data-role={role}>
  <a class="em-card-plate" href={u.article(lang, id)} aria-hidden="true" tabindex="-1">
    <Plate seed={id} category={type} size={96} variant="plate" />
  </a>
  <div class="em-card-body">
    {no !== undefined && <p class="em-card-no"><LenGauge id={id} lang={lang} />Nº {String(no).padStart(4, '0')}</p>}
    <h3><a href={u.article(lang, id)}>{hw}</a></h3>
    {lang !== 'pt' && hw_pt && hw_pt !== hw && <p class="em-card-pt" lang="pt"><em>{hw_pt}</em></p>}
    {abs && <p class="em-card-abs">{abs}{ml && <span class="em-ml" title="English metadata">EN</span>}</p>}
  </div>
</article>
<style>
  .em-card { display: flex; gap: .85rem; align-items: flex-start; }
  .em-card-plate { flex: none; color: var(--ink); display: block; }
  .em-card[data-role='place'] .em-card-plate { color: var(--place); }
  .em-card[data-role='person'] .em-card-plate { color: var(--person); }
  .em-card[data-role='event'] .em-card-plate { color: var(--date); }
  .em-card-no { font-size: .7rem; letter-spacing: .08em; margin: 0 0 .15rem; opacity: .6; font-variant-numeric: tabular-nums; }
  .em-card h3 { margin: 0 0 .2rem; font-size: 1.15rem; line-height: 1.2; }
  .em-card h3 a { color: var(--ink); text-decoration: none; }
  .em-card h3 a:hover { color: var(--person); }
  .em-card-pt { margin: 0 0 .3rem; font-size: .82rem; opacity: .7; }
  .em-card-abs { margin: 0; font-size: .88rem; line-height: 1.4; opacity: .88; }
  .em-ml { font-size: .6rem; border: 1px solid currentColor; border-radius: 2px; padding: 0 .25em; margin-left: .4em; opacity: .6; vertical-align: middle; }
</style>
