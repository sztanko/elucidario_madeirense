---
// Plane-of-articles motion layer (owner: motion agent). Include ONCE per page, ideally inside <head>
// (it only emits <script>/<style>; see site/src/motion/README.md). Works from the end of <body> too,
// but then a pagereveal that fires before the parser reaches it is missed (→ default cross-fade).
//
// Props (all optional; derived from the URL when omitted):
//   id   article id of this page (article pages only)
//   lang page language
import { planeIndex, planeVersion, planeModules } from '../../motion/build';
import { inlineConfig, coreScript } from '../../motion/inline';
import { createHash } from 'node:crypto';
import { BASE } from '../../lib/urls';
import { t } from '../../i18n/ui';
import { languages } from '../../lib/data';

interface Props { id?: string; lang?: string }
const parts = Astro.url.pathname.slice(BASE.length).split('/').filter(Boolean);
const langs = languages();
const lang = Astro.props.lang ?? (langs.includes(parts[0]) ? parts[0] : 'en');
const id = Astro.props.id ?? (parts[1] === 'a' ? parts[2] : undefined);
const mods = planeModules(BASE);
const v = mods ? planeVersion() : '';
const cfg = { i: v ? planeIndex(id) : -1, l: lang, v, b: BASE, s: t(lang as any, 'plane_sheet'), e: mods?.e ?? '', o: mods?.o ?? '' };
// The static handler code is one cached, parser-blocking file (it must run before the first render to catch
// `pagereveal`); only the per-page config is inline. Written at build end by src/art/plates-out.mjs.
const core = coreScript();
const corePath = `plane/core-${createHash('sha1').update(core).digest('hex').slice(0, 10)}.js`;
((globalThis as any).__emFiles ??= new Map()).set(corePath, core);
---
<script is:inline set:html={inlineConfig(cfg)} />
<script is:inline src={`${BASE}/${corePath}`}></script>
<script>
  import '../../motion/boot';
</script>
<style is:global>
  /* Cross-document view transitions (Chrome/Edge 126+, Safari 18.2+). Off under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }
  }
  /* default page change (non-article targets, lang switch): short cross-fade */
  ::view-transition-old(root), ::view-transition-new(root) { animation-duration: 200ms; }

  /* capture layer created by the inline pagereveal handler */
  #em-fly {
    position: fixed; inset: 0; z-index: 2147483646; pointer-events: none; contain: strict;
    view-transition-name: em-plane; background: var(--paper, #e8dfca);
  }
  #em-fly canvas { display: block; width: 100%; height: 100%; }

  /* fly: root (old snapshot + new page) above the live plane canvas; JS drives both images */
  html.em-fly::view-transition-group(root) { z-index: 1; animation: none; }
  html.em-fly::view-transition-image-pair(root) { isolation: auto; }
  html.em-fly::view-transition-old(root),
  html.em-fly::view-transition-new(root) {
    animation: em-hold-o 3s linear both; mix-blend-mode: normal; transform-origin: 0 0;
  }
  html.em-fly::view-transition-new(root) { animation-name: em-hold-n; }
  html.em-fly::view-transition-group(em-plane),
  html.em-fly::view-transition-new(em-plane) { animation: none; }
  @keyframes em-hold-o { from, to { opacity: 1; } }
  @keyframes em-hold-n { from, to { opacity: 0; } }

  /* late: engine not ready within 650 ms → short cross-fade, sheet hidden */
  html.em-late::view-transition-old(root) { animation: em-fade-out 180ms ease-out both; mix-blend-mode: normal; }
  html.em-late::view-transition-new(root) { animation: em-fade-in 180ms ease-out both; mix-blend-mode: normal; }
  html.em-late::view-transition-new(em-plane) { animation: em-hold-n 180ms both; }
  @keyframes em-fade-out { to { opacity: 0; } }
  @keyframes em-fade-in { from { opacity: 0; } }

  /* card (low-end fallback): a vermilion title field cuts between the pages, compositor-only */
  html.em-card #em-fly {
    background: var(--person, #bd3426); display: flex; align-items: flex-end;
    padding: 0 var(--gutter, 1rem) 18vh;
  }
  html.em-card #em-fly span {
    font: var(--w-display, 860) clamp(3rem, 2rem + 9vw, 10rem) / .86 var(--font-display, sans-serif);
    text-transform: uppercase; color: var(--paper-light, #f2ead8); overflow-wrap: anywhere;
  }
  html.em-card::view-transition-old(root) { animation: em-c-o 420ms linear both; }
  html.em-card::view-transition-new(root) { animation: em-c-n 420ms linear both; }
  html.em-card::view-transition-group(em-plane) { animation: none; }
  html.em-card::view-transition-new(em-plane) { animation: em-c-card 420ms cubic-bezier(.2,.7,.1,1) both; }
  @keyframes em-c-o { 0%, 40% { opacity: 1; } 41%, 100% { opacity: 0; } }
  @keyframes em-c-n { 0%, 40% { opacity: 0; } 41%, 100% { opacity: 1; } }
  @keyframes em-c-card {
    0% { opacity: 0; transform: translateY(3%); }
    32%, 60% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: none; }
  }
</style>
